# --- App ---
PORT=3010
NODE_ENV=development

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=chefai
DB_PASSWORD=chefai
DB_NAME=chefai

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- IA (Google Gemini - tier gratuito, obtener en https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chef-ai-uploads
R2_PUBLIC_URL=
